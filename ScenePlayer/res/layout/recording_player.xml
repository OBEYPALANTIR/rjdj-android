<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#FAF9F6">
    <TextView android:id="@+id/recording_play_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold"
        android:textColor="#201E25" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/recording_play_artist" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#605D67" />
    <ImageView android:id="@+id/recording_play_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"
        android:layout_marginVertical="12dp" android:importantForAccessibility="no" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/date" android:textColor="#605D67" />
    <TextView android:id="@+id/recording_play_date_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#201E25" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/duration" android:textColor="#605D67" />
    <TextView android:id="@+id/recording_play_duration_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#201E25" />
    <TextView android:id="@+id/recording_play_description_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#201E25"
        android:maxLines="3" android:ellipsize="end" android:layout_marginTop="8dp" />
    <SeekBar android:id="@+id/recording_play_seekbar" android:layout_width="match_parent"
        android:layout_height="48dp" android:contentDescription="@string/recording_position" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:orientation="horizontal">
        <ToggleButton android:id="@+id/recording_play_play_button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp"
            android:checked="false" android:textOn="@string/pause_action" android:textOff="@string/paused" />
        <ImageButton android:id="@+id/recording_play_scene_button" android:layout_width="56dp"
            android:layout_height="56dp" android:src="@drawable/transport_goto_scene"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_scene" />
        <ImageButton android:id="@+id/recording_play_rename_button" android:layout_width="56dp"
            android:layout_height="56dp" android:src="@drawable/transport_edit_description"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/rename_recording" />
    </LinearLayout>
</LinearLayout>
